</ukm:Section></ukm:CommencementAuthority><ukm:InForceDates><ukm:InForce Date="2011-06-18" Qualification="wholly in force"/></ukm:InForceDates></ukm:UnappliedEffect><ukm:UnappliedEffect AffectedProvisions="Rules" AffectingNumber="1125" Notes="This amendment not applied to legislation.gov.uk. S.I. 2018/1125, reg. 8 omitted (31.12.2020) by virtue of Private International Law (Implementation of Agreements) Act 2020 (c. 24), s. 4(3), Sch. 5 para. 4(4)" Comments="IP completion day" AppendedCommentary="2020 c. 1, Sch. 5 para. 1(1)" AffectedExtent="E+W" AffectedNumber="2955" Row="1242" AffectedYear="2010" EffectId="lgid-4b904c4a7aea93ce08a4c5406c9cfd08" Modified="2022-09-15T17:38:49Z" AffectedURI="http://www.legislation.gov.uk/id/uksi/2010/2955" AffectingYear="2018" AffectingClass="UnitedKingdomStatutoryInstrument" RequiresApplied="false" AffectingEffectsExtent="E+W+S+N.I." Type="applied (with modifications)" AffectedClass="UnitedKingdomStatutoryInstrument" URI="http://www.legislation.gov.uk/id/effect/lgid-4b904c4a7aea93ce08a4c5406c9cfd08" AffectingURI="http://www.legislation.gov.uk/id/uksi/2018/1125" AffectingProvisions="reg. 8"><ukm:AffectedTitle>The Family Procedure Rules 2010</ukm:AffectedTitle><ukm:AffectedProvisions><ukm:Section xmlns:err="http://www.legislation.gov.uk/namespaces/error" Ref="Rules" URI="http://www.legislation.gov.uk/id/uksi/2010/2955" err:Ref="Section missing in legislation" Missing="true">Rules</ukm:Section></ukm:AffectedProvisions><ukm:AffectingTitle>The International Recovery of Maintenance (Hague Convention on the International Recovery of Child Support and Other Forms of Family Maintenance 2007) (EU Exit) Regulations 2018</ukm:AffectingTitle><ukm:AffectingProvisions><ukm:Section Ref="regulation-8" URI="http://www.legislation.gov.uk/id/uksi/2018/1125/regulation/8">reg. 8</ukm:Section></ukm:AffectingProvisions><ukm:CommencementAuthority><ukm:Section Ref="regulation-1" URI="http://www.legislation.gov.uk/id/uksi/2018/1125/regulation/1">reg. 1</ukm:S