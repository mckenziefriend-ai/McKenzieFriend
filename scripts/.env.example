# Credentials for scripts/ingest-legislation.ts --writer=db
#
# Copy this file to scripts/.env and fill in the values.
# scripts/.env is gitignored (".env*") — git will refuse to add it.
#
# ############################ WARNING ############################
# SUPABASE_SERVICE_ROLE_KEY BYPASSES ROW LEVEL SECURITY COMPLETELY.
# Anyone holding it can read and write every user's case data.
#
#   - Keep it ONLY in scripts/.env on your own machine.
#   - NEVER put it in the app, in .env.local, in Vercel, in CI, in a
#     commit, or in a pull request.
#   - It is not needed to run the app — only this one offline script.
#   - Prefer `--writer=sql`, which needs no key at all and emits SQL
#     files to paste into the Supabase SQL editor.
#
# The script refuses to start if this value is found in any tracked file.
# #################################################################

# Supabase project URL, e.g. https://xxxxxxxxxxxx.supabase.co
# (Settings -> API -> Project URL)
SUPABASE_URL=

# Service role key (Settings -> API -> Project API keys -> service_role).
# Treat as maximally sensitive. Rotate immediately if it ever leaks.
SUPABASE_SERVICE_ROLE_KEY=

# OpenAI key, used ONLY by scripts/embed-corpus.ts to build the semantic index.
# The app has its own OPENAI_API_KEY for query-time embedding; this copy exists
# so the offline indexer never depends on the app's environment.
# The script refuses to start if this value is found in any tracked file.
OPENAI_API_KEY=
