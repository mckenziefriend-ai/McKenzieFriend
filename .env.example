# Supabase project (Settings -> API in the Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# OpenAI API key used by the AI routes. Set a hard spend cap on this key.
OPENAI_API_KEY=

# Optional: public origin of this deployment, used for the signup email
# confirmation redirect (falls back to window.location.origin if unset).
# This URL must also be added to Supabase Auth -> URL Configuration ->
# Redirect URLs, or the confirmation redirect fails silently.
NEXT_PUBLIC_SITE_URL=
