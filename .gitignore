# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env*

# safe env template
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# generated ingestion SQL (review + paste into Supabase, not source)
/scripts/out/

# downloaded legislation XML cache (re-fetchable; multi-MB)
/scripts/.cache/

# retrieval eval run snapshots — scratch runs are regenerated, not source
# (contents, not the directory — git will not descend into an excluded
# directory, so a negation below it would never be reached)
/scripts/eval/runs/*
# ...except the reference a change is measured against. Reproducing one needs
# the live corpus and an OPENAI_API_KEY, so it does not regenerate the way the
# rest of this list does, and a comparison is only meaningful against the state
# the numbers in the commit message were taken from. Track those explicitly.
!/scripts/eval/runs/part-context.json
